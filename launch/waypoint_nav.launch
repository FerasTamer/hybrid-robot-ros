<?xml version="1.0"?>
<launch>
  <node name="lyapunov_controller"
        pkg="hybrid_robot"
        type="lyapunov_controller.py"
        output="screen">
    <param name="k_rho"        value="0.4"/>
    <param name="k_alpha"      value="1.2"/>
    <param name="k_beta"       value="-0.3"/>
    <param name="max_linear"   value="0.3"/>
    <param name="max_angular"  value="1.0"/>
    <param name="goal_tol"     value="0.05"/>
  </node>
</launch>
